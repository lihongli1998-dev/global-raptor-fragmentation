// ============================================================================
// Annual Forest Loss within Species' Areas of Habitat (AOH)
// ----------------------------------------------------------------------------
// Calculates annual forest loss (km²) for each forest-dependent raptor species
// using Hansen Global Forest Change v1.11 (2023).
//
// Forest loss is quantified by summing the area of pixels classified as loss
// (lossyear) within each species' AOH for every year between 2001 and 2020.
//
// Output:
// Species_Annual_Forest_Loss.csv
// ============================================================================


// ==============================================================
// Dynamic Pixel-Area Forest Loss Analysis (2000-2020)
// Dataset: Hansen Global Forest Change v1.11 (2023)
// Output: Annual forest loss area (km²) per species
// ==============================================================

// --------------------- DATA LOADING ---------------------------
var dataset = ee.Image("UMD/hansen/global_forest_change_2023_v1_11");
var lossyear = dataset.select("lossyear"); 
var treecover2000 = dataset.select("treecover2000"); 

var speciesCollection = ee.FeatureCollection('projects/**');

// --------------- CORE CALCULATION FUNCTION --------------------
function calculateAnnualLoss(speciesFeature) {
  var geometry = speciesFeature.geometry();
  var speciesID = speciesFeature.get('Species_ID');  //species id
  var areaKm2 = ee.Image.pixelArea().divide(1e6);  // Convert m² to km²

  // Process each year from 2001 to 2020
  var annualLossData = ee.List.sequence(1, 20).map(function(year) {
    var lossMask = lossyear.eq(ee.Number(year));

    var weightedLoss = lossMask
      .multiply(areaKm2)
      .rename('weighted_loss');

    var lossArea = weightedLoss.reduceRegion({
      reducer: ee.Reducer.sum(),
      geometry: geometry,
      scale: 30,
      maxPixels: 1e13
    }).get('weighted_loss'); 

    lossArea = ee.Number(ee.Algorithms.If(ee.Algorithms.IsEqual(lossArea, null), 0, lossArea));
    
    return ee.Feature(null, {
      'species_id': speciesID,
      'year': ee.Number(year).add(2000),
      'forest_loss_km2': lossArea
    });
  });

  return ee.FeatureCollection(annualLossData);
}
// ------------------ BATCH PROCESSING --------------------------
var allSpeciesLoss = speciesCollection.map(calculateAnnualLoss).flatten();
// -------------------- EXPORT SETTINGS --------------------------
Export.table.toDrive({
  collection: allSpeciesLoss,
  description: 'Species_Annual_Forest_Loss',
  fileFormat: 'CSV',
  folder: 'Forest_Loss',
  selectors: ['species_id', 'year', 'forest_loss_km2']
});
